{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run check && npm run build && python3 scripts/prepare_vercel.py",
  "outputDirectory": "dist",
  "functions": {
    "api/service.py": {
      "maxDuration": 30,
      "excludeFiles": "{frontend/**,node_modules/**,tests/**,docs/**,vendor/**,app/static/**,dist/**,scripts/**,.github/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/service?route=:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
